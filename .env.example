# --- DISCORD CONFIGURATION ---
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=optional_guild_id_for_fast_registration

# --- CLOUDFLARE R2 (State Snapshots) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=undead-bot-state

# --- CLOUDFLARE D1 (Relational Stats) ---
D1_DATABASE_ID=your_d1_database_id
D1_API_TOKEN=your_cloudflare_api_token_with_d1_edit_permissions
D1_ACCOUNT_ID=your_cloudflare_account_id

# --- GITHUB CONFIGURATION (For Reviver) ---
GITHUB_PAT=your_github_personal_access_token_with_workflow_scope
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_WORKFLOW=bot.yml

# --- REVIVER CONFIGURATION ---
REVIVER_SECRET=a_long_random_shared_secret_string
REVIVER_URL=https://your-reviver-app.fly.dev
PORT=8080
