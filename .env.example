# --- DISCORD BOTS ---
# Add one env var set per bot folder, for example bot/bot1 or bot/bot2.
BOT_BOT1_TOKEN=your_bot1_token
BOT_BOT2_TOKEN=your_bot2_token
BOT_BOT3_TOKEN=optional_bot3_token
BOT_BOT1_PREFIX=!
BOT_BOT2_PREFIX=?
BOT_BOT3_PREFIX=#
BOT_BOT1_ENABLED=true
BOT_BOT2_ENABLED=true
BOT_BOT3_ENABLED=true
BOT_BOT1_DISPLAY_NAME=Bot One
BOT_BOT2_DISPLAY_NAME=Bot Two
BOT_BOT3_DISPLAY_NAME=Bot Three
BOT_BOT1_HELLO_MESSAGE=Hello from bot1 👻
BOT_BOT2_HELLO_MESSAGE=Hello from bot2 👻
BOT_BOT3_HELLO_MESSAGE=Hello from bot3 👻

# --- RUNTIME TUNING ---
BOT_STARTUP_DELAY_MS=5000
BOT_AUTOSAVE_MS=60000

# --- CLOUDFLARE R2 (Per-Bot Checkpoints) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=undead-bot-platform

# --- CLOUDFLARE D1 (Shared Runtime Database) ---
D1_DATABASE_ID=your_d1_database_id
D1_API_TOKEN=your_cloudflare_api_token_with_d1_edit_permissions
D1_ACCOUNT_ID=your_cloudflare_account_id

# --- REVIVER <-> GITHUB ACTIONS ---
GITHUB_PAT=your_github_personal_access_token_with_workflow_scope
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_WORKFLOW=bot.yml
GITHUB_REF=main

# --- REVIVER SHARED SECRET ---
REVIVER_SECRET=a_long_random_shared_secret_string
REVIVER_URL=https://your-reviver-app.fly.dev

# --- FLY.IO / LOCAL REVIVER ---
PORT=8080
